<ContentDialog
    x:Class="kaliteConfig.Controls.RuleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:local="using:kaliteConfig.Controls"
    Title="New rule"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="12"
    PrimaryButtonClick="Dialog_PrimaryClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto" Padding="0,0,13,0">
        <Grid x:Name="Root" Width="1060" RowSpacing="6" KeyDown="Root_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Target process" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <AutoSuggestBox x:Name="TargetBox" PlaceholderText="Type a process name or pattern"
                                    Text="{x:Bind Draft.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="TargetBox_TextChanged"
                                    SuggestionChosen="TargetBox_SuggestionChosen"
                                    PreviewKeyDown="TargetBox_PreviewKeyDown"
                                    ToolTipService.ToolTip="Type part of a name and pick it, or type your own pattern. A comma separates several targets." />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Applies to" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="AppliesBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                              CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1">
                        <ComboBoxItem Content="Always" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LiveTargetStatusText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Tab picks the top match · Enter picks the highlighted one"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton x:Name="ShowLiveThreadsButton" Grid.Column="1" Content="Show running threads"
                                 Padding="6,0" VerticalAlignment="Center" Visibility="Collapsed"
                                 Click="ShowLiveThreads_Click"
                                 ToolTipService.ToolTip="Open the thread rules tab and list the threads this process has right now" />
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TabSettings" Grid.Column="0" Content="Process rules" HorizontalAlignment="Stretch" Click="Tab_Click" Tag="Settings" />
                <Button x:Name="TabThreads" Grid.Column="1" Content="Thread rules" HorizontalAlignment="Stretch" Click="Tab_Click" Tag="Threads" />
            </Grid>

            <StackPanel x:Name="SettingsPanel" Grid.Row="3" Spacing="6">
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Process priority" VerticalAlignment="Center"
                                  IsChecked="{x:Bind PriorityEnabled, Mode=TwoWay}" />
                        <ComboBox x:Name="ProcessPriorityCombo" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1"
                                  ItemsSource="{x:Bind ProcessPriorityNames, Mode=OneWay}"
                                  SelectedItem="{x:Bind PriorityName, Mode=TwoWay}"
                                  SelectionChanged="ProcessRowCombo_SelectionChanged" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Priority boost" VerticalAlignment="Center"
                                  IsChecked="{x:Bind BoostEnabled, Mode=TwoWay}" />
                        <ComboBox x:Name="ProcessBoostCombo" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1"
                                  ItemsSource="{x:Bind ToggleNames, Mode=OneWay}"
                                  SelectedItem="{x:Bind BoostName, Mode=TwoWay}"
                                  SelectionChanged="ProcessRowCombo_SelectionChanged" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Efficiency mode" VerticalAlignment="Center"
                                  IsChecked="{x:Bind EfficiencyEnabled, Mode=TwoWay}" />
                        <ComboBox x:Name="ProcessEfficiencyCombo" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1"
                                  ItemsSource="{x:Bind ToggleNames, Mode=OneWay}"
                                  SelectedItem="{x:Bind EfficiencyName, Mode=TwoWay}"
                                  SelectionChanged="ProcessRowCombo_SelectionChanged" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Protect process threads" VerticalAlignment="Center"
                                  IsChecked="{x:Bind Draft.ProtectThreads, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Prevents Global Optimize from stripping priority boosts off this process's threads." />
                        <TextBlock Grid.Column="1" Text="Exclude this process from global priority boost stripping" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="CPU affinity" VerticalAlignment="Center"
                                  IsChecked="{x:Bind AffinityEnabled, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" x:Name="DraftAffinitySummaryText" Text="All logical processors" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        <Button Grid.Column="2" x:Name="AffinityChooseButton" Content="Choose..." Click="AffinityChoose_Click" CornerRadius="{ThemeResource ControlCornerRadius}" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="CPU Sets" VerticalAlignment="Center"
                                  IsChecked="{x:Bind CpuSetsEnabled, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" x:Name="CpuSetsSummaryText" Text="All logical processors" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        <Button Grid.Column="2" x:Name="CpuSetsChooseButton" Content="Choose..." Click="CpuSetsChoose_Click" CornerRadius="{ThemeResource ControlCornerRadius}" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid x:Name="ThreadsPanel" Grid.Row="3" Visibility="Collapsed" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="LiveThreadsHeaderText" Grid.Row="0" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Live threads - loading…" />
                    <ListView x:Name="LiveThreadsList" Grid.Row="1" MinHeight="150" MaxHeight="240" SelectionMode="Single"
                              SelectionChanged="LiveThreadsList_SelectionChanged"
                              DoubleTapped="LiveThreadsList_DoubleTapped"
                              ToolTipService.ToolTip="Threads this process has right now. Pick one, then add a rule for exactly that thread.">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Margin" Value="0,1,8,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LiveThreadChoice">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Description}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TidText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="AddPickedThreadButton" Content="Add rule for selected thread"
                                Click="AddPickedThread_Click" CornerRadius="{ThemeResource ControlCornerRadius}" HorizontalAlignment="Stretch" IsEnabled="False"
                                ToolTipService.ToolTip="Add a rule that targets the thread selected above" />
                        <Button Grid.Column="1" Content="Every thread" Click="AddAllThreadsRule_Click" CornerRadius="{ThemeResource ControlCornerRadius}"
                                ToolTipService.ToolTip="Add one rule that matches every thread of this process" />
                        <Button Grid.Column="2" x:Name="LiveThreadRefreshButton" Content="Refresh" Click="LiveThreadRefresh_Click" CornerRadius="{ThemeResource ControlCornerRadius}"
                                ToolTipService.ToolTip="Re-read the thread list of the target process named above" />
                    </Grid>

                    <TextBlock x:Name="ThreadRulesHeaderText" Grid.Row="3" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="No thread rules" />
                    <ListView x:Name="ThreadRulesList" Grid.Row="4" MinHeight="120" MaxHeight="220" SelectionMode="Single"
                              ItemsSource="{x:Bind Draft.ThreadRules, Mode=OneWay}"
                              SelectionChanged="ThreadRulesList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Margin" Value="0,2,8,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TunerThreadRule">
                                <Grid ColumnSpacing="6" Padding="0,4">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Delete rule" Click="ThreadRule_DeleteFlyout_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" Visibility="{x:Bind NamedVis, Mode=OneWay}"
                                              ToolTipService.ToolTip="Named thread - pinned to top" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind TargetText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind PriorityText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind RuleIdText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="5" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Delete rule" Click="ThreadRule_DeleteButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}" />
                        </StackPanel>
                        <TextBlock x:Name="ThreadRulesStatusText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Spacing="7" Margin="0,0,13,0">
                        <TextBlock Text="Select a thread rule to inspect and tune it." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   x:Name="RuleNoSelectionText" />
                        <StackPanel Spacing="7" x:Name="RuleEditorPanel" Visibility="Collapsed">
                            <TextBlock x:Name="RuleEditorTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="RuleEditorSub" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="Thread priority" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="RulePriorityCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="RulePriorityCombo" Width="220" HorizontalAlignment="Left" PlaceholderText="Select priority…" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1" SelectionChanged="RulePriorityCombo_SelectionChanged">
                                <ComboBoxItem Content="Idle (-15)" Tag="-15" />
                                <ComboBoxItem Content="Lowest (-2)" Tag="-2" />
                                <ComboBoxItem Content="Below normal (-1)" Tag="-1" />
                                <ComboBoxItem Content="Normal (0)" Tag="0" />
                                <ComboBoxItem Content="Above normal (+1)" Tag="1" />
                                <ComboBoxItem Content="Highest (+2)" Tag="2" />
                                <ComboBoxItem Content="Time critical (+15)" Tag="15" />
                            </ComboBox>

                            <TextBlock Text="Memory priority" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="RuleMemoryCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <ComboBox x:Name="RuleMemoryCombo" Width="220" HorizontalAlignment="Left" PlaceholderText="System default" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1"
                                      SelectionChanged="RuleMemoryCombo_SelectionChanged"
                                      ToolTipService.ToolTip="Windows memory priority for the matched threads (1 = very low, 5 = normal). System default leaves it unchanged.">
                                <ComboBoxItem Content="System default" Tag="default" />
                                <ComboBoxItem Content="Very low (1)" Tag="1" />
                                <ComboBoxItem Content="Low (2)" Tag="2" />
                                <ComboBoxItem Content="Medium (3)" Tag="3" />
                                <ComboBoxItem Content="Below normal (4)" Tag="4" />
                                <ComboBoxItem Content="Normal (5)" Tag="5" />
                            </ComboBox>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="Efficiency mode (EcoQoS)" Style="{StaticResource BodyTextBlockStyle}" />
                                    <TextBlock Text="Runs these threads on low-power scheduling when the CPU is not busy."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource KaliteToggleSwitchStyle}" x:Name="RuleEcoToggle"
                                              Toggled="RuleEcoToggle_Toggled" ToolTipService.ToolTip="Efficiency mode (EcoQoS) - ON = low-power scheduling" />
                            </Grid>

                            <TextBlock Text="CPU affinity - tick the CPUs this thread may run on" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="RuleAffinityCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Grid x:Name="RuleAffinityCpuGrid" ColumnSpacing="4" RowSpacing="4" />
                            <Button Content="Apply affinity" Click="RuleAffinityApply_Click" HorizontalAlignment="Left" />

                            <TextBlock Text="Ideal processor - pick one preferred CPU the thread's affinity mask allows" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="RuleIdealCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Grid x:Name="RuleIdealCpuGrid" ColumnSpacing="4" RowSpacing="4" />
                            <Button Content="Apply ideal processor" Click="RuleIdealApply_Click" HorizontalAlignment="Left" />

                            <Button Content="Delete rule" HorizontalAlignment="Left" Click="ThreadRule_DeleteButton_Click" CornerRadius="{ThemeResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="Remove this thread rule from the profile" />

                            <TextBlock x:Name="RuleEditorStatusBox" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,7">
                <TextBlock x:Name="SummaryText" Text="0 process settings · 0 thread rules" Style="{StaticResource BodyTextBlockStyle}" />
            </Border>

            <TextBlock x:Name="ErrorText" Grid.Row="5" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="6" Text="Esc closes · Ctrl+Enter applies" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </ScrollViewer>
</ContentDialog>
