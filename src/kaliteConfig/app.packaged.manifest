<?xml version="1.0" encoding="utf-8"?>
<!-- Packaged (MSIX) manifest. Used ONLY when building with /p:Packaged=true
     (see kaliteConfig.csproj ApplicationManifest condition + Installer/MSIX/Build-MSIX.ps1).
     A packaged app CANNOT launch with requireAdministrator (activation fails), so this
     declares asInvoker. Admin-only tweaks keep working through their existing
     IsElevated() gates + per-action "runas" elevation, just without auto-elevation
     at launch. The unpackaged/Inno build keeps using app.manifest (requireAdministrator). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="kaliteConfig.app"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- The ID below informs the system that this application is compatible with OS features first introduced in Windows 10.
      It is necessary to support features in unpackaged applications, for example the custom titlebar implementation.
      For more info see https://docs.microsoft.com/windows/apps/windows-app-sdk/use-windows-app-sdk-run-time#declare-os-compatibility-in-your-application-manifest -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
