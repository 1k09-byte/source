<Page
    x:Class="kaliteConfig.Pages.WindowsSettingsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d" Background="Transparent" NavigationCacheMode="Required">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="28,16,28,0" Spacing="2">
            <TextBlock Text="Windows Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="System switches for Windows, in one place."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer x:Name="SystemPanel" Grid.Row="1" Padding="28,16,28,20" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsPanel" Spacing="8">
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU and power tuning" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="14,4,0,0" />
                        <toolkit:SettingsCard x:Name="PowerModeCard" Header="Kernel/Power settings"
                                              Description="Balanced keeps the Windows defaults. Aggressive applies the power and kernel flags: power-event processing and parked-core requests off, QoS hint computation and IPI last-clock-owner handling on, no display burst on power-source change, and forced core parking off. Needs administrator rights and a restart.">
                            <ToggleSwitch Style="{StaticResource KaliteToggleSwitchStyle}" x:Name="PowerModeToggle" OffContent="Balanced" OnContent="Aggressive" Toggled="PowerMode_Toggled" />
                        </toolkit:SettingsCard>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">
                        <toolkit:SettingsCard x:Name="MmcssCard" Header="Multimedia Class Scheduler (MMCSS)"><ToggleSwitch Style="{StaticResource KaliteToggleSwitchStyle}" x:Name="MmcssToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="MmcssStatus"/></toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="HibernateCard" Header="Hibernation" Description="Turning it off clears the hibernate flags and keeps fast startup off. Needs administrator rights."><ToggleSwitch Style="{StaticResource KaliteToggleSwitchStyle}" x:Name="HibernateToggle" OffContent="Off" OnContent="On" Toggled="Hibernate_Toggled"/></toolkit:SettingsCard>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Security and virtualization" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="14,4,0,0" />
                        <toolkit:SettingsCard x:Name="VbsCard" Header="Virtualization-Based Security (VBS)"><ToggleSwitch Style="{StaticResource KaliteToggleSwitchStyle}" x:Name="VbsToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="Vbs"/></toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="HvciCard" Header="Memory integrity (HVCI)"><ToggleSwitch Style="{StaticResource KaliteToggleSwitchStyle}" x:Name="HvciToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="Hvci"/></toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="DmaCard" Header="Kernel DMA Protection" Description="Writes GraphicsDrivers\IOMMUFlags (1 = on, 0 = off). Needs administrator rights and a restart."><ToggleSwitch Style="{StaticResource KaliteToggleSwitchStyle}" x:Name="DmaToggle" OffContent="Off" OnContent="On" Toggled="Dma_Toggled"/></toolkit:SettingsCard>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GPU scheduling" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="14,4,0,0" />
                        <toolkit:SettingsCard x:Name="HagsCard" Header="Hardware-accelerated GPU scheduling (HAGS)"><ToggleSwitch Style="{StaticResource KaliteToggleSwitchStyle}" x:Name="HagsToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="HwSchMode"/></toolkit:SettingsCard>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">
                        <toolkit:SettingsCard x:Name="SvcSplitCard" Header="Service host splitting threshold" Description="Reading…"><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="SvcSplitBox" PlaceholderText="Select RAM size" SelectionChanged="SvcSplitBox_SelectionChanged" MinWidth="220"/><Button Content="Reset" Click="SvcSplitReset_Click"/></StackPanel></toolkit:SettingsCard>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
